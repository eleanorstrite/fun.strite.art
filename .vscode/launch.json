{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Sidequest",
      "type": "debugpy",
      "request": "launch",
      "module": "http.server",
      "args": ["8000", "--bind", "127.0.0.1"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": { "PYTHONUNBUFFERED": "1" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Serving HTTP on .* port ([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s"
      }
    }
  ]
}
